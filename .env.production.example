# Copy to .env.production on the VPS.
# These are public (baked into client bundle) — not secrets — but kept in
# .env for consistency with followers-api and to allow per-host overrides.

NUXT_PUBLIC_WEB_URI=https://followersbicara.com
NUXT_PUBLIC_API_URI=https://api.followersbicara.com

# ── Image tag (set by deploy workflow; defaults to :latest) ──
# WEB_IMAGE_TAG=v1.8.0
